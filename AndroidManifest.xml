<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.explorationbase.ExplorationLite"
    android:versionCode="133"
    android:versionName="1.3.3-reimpl">

    <!-- min 19 matches NDK APP_PLATFORM; target 28 avoids some Android 14 install quirks -->
    <uses-sdk android:minSdkVersion="19" android:targetSdkVersion="28"/>
    <uses-feature android:glEsVersion="0x00010000" android:required="true"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"/>

    <!-- hasCode=false: pure native APK, no classes.dex (fixes INSTALL_FAILED_INVALID_APK "code is missing") -->
    <application
        android:allowBackup="true"
        android:hasCode="false"
        android:extractNativeLibs="true"
        android:icon="@drawable/icon"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen">

        <activity
            android:name="android.app.NativeActivity"
            android:label="@string/app_name"
            android:exported="true"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize"
            android:screenOrientation="sensorLandscape"
            android:launchMode="singleTask">
            <meta-data android:name="android.app.lib_name" android:value="ExplorationLite"/>
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
